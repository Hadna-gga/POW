# Copia este archivo como ".env" (dentro de la carpeta backend) y completa los valores.
# NUNCA subas el archivo .env al repositorio.

# Puerto del servidor
PORT=3000

# Cadena de conexión de MongoDB (Atlas o local)
#   Local: mongodb://127.0.0.1:27017/delcampo
#   Atlas: mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/delcampo
MONGO_URI=

# Secreto con el que se firman los JWT. Usa una cadena larga y aleatoria:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ----- OPCIONAL: inicio de sesión con Google (OAuth 2.0) -----
# Si se dejan vacías, el sitio funciona igual con correo y contraseña
# (los botones "Continuar con Google" responderán que no está configurado).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/usuarios/google/callback

# Comisión solidaria (porcentaje del valor de los productos de cada compra).
# Es visible en el carrito y en cada pedido. Si se deja vacía, se usa 5.
COMISION_PORCENTAJE=5